# ---------------------------------------------------------------------------
# Base de données — Supabase (PostgreSQL)
# ---------------------------------------------------------------------------
# Où trouver l'URL : tableau de bord Supabase > Project Settings > Database
# > Connection string > onglet "URI". Remplacez [YOUR-PASSWORD] par le mot de
# passe de la base (il est masqué dans l'interface).
#
# Format : postgresql://postgres.<project-ref>:<mot-de-passe>@<hôte>:5432/postgres?sslmode=require
#
# Conseil : sur Supabase, préférez la chaîne du "Session pooler" (hôte du type
# aws-0-<region>.pooler.supabase.com, port 5432). Elle fonctionne à la fois pour
# l'application et pour `npx prisma db push`, et elle est compatible IPv4.
#
# Si vous utilisez le "Transaction pooler" (port 6543), ajoutez
# `?pgbouncer=true&connection_limit=1` et gardez le port 5432 pour db push.
#
# ⚠️ Les guillemets sont obligatoires (les URL contiennent des caractères spéciaux).
# ⚠️ Ne commitez jamais le fichier .env : seul .env.example est versionné.
DATABASE_URL="postgresql://postgres.<project-ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Session (obligatoire en production)
# ---------------------------------------------------------------------------
# Générer avec : openssl rand -base64 48
AUTH_SECRET="dev-only-insecure-secret-change-me-please-32-chars"

# ---------------------------------------------------------------------------
# URL publique (utilisée pour les liens de partage WhatsApp et les webhooks)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Paiement Mobile Money — CinetPay
# Laisser vide tant que le compte marchand n'est pas ouvert.
# Tant que ces variables sont absentes, seul le paiement à la réception
# (espèces / transfert direct au vendeur) est proposé aux clients.
# ---------------------------------------------------------------------------
# API CinetPay v1 : un Bearer token est obtenu via /v1/oauth/login avec
# CINETPAY_API_KEY + CINETPAY_API_PASSWORD avant chaque appel.
# Sandbox : https://api.cinetpay.net — Production : https://api.cinetpay.co
CINETPAY_API_KEY=""
CINETPAY_API_PASSWORD=""
CINETPAY_API_URL="https://api.cinetpay.net"

# ---------------------------------------------------------------------------
# Commission plateforme en points de base (100 = 1 %). 500 = 5 %, déduits de
# la part vendeur (95 % reversés). Une valeur absente ou nulle retombe sur 500.
# ---------------------------------------------------------------------------
PLATFORM_FEE_BPS="500"

# ---------------------------------------------------------------------------
# Photos produits — Supabase Storage (obligatoire en production)
# ---------------------------------------------------------------------------
# Supabase > Project Settings > API : « Project URL » et clé « service_role ».
# Vercel est en lecture seule : les photos ne peuvent pas être écrites dans
# public/uploads. La clé service_role contourne les règles RLS, elle ne doit
# jamais être exposée côté navigateur.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket public, créé automatiquement au premier envoi s'il n'existe pas.
SUPABASE_STORAGE_BUCKET="products"

# ---------------------------------------------------------------------------
# Codes OTP par email — Resend OU Brevo (un seul suffit)
# ---------------------------------------------------------------------------
# Resend : https://resend.com > API Keys.
#   ⚠️ Sans domaine vérifié, l'adresse onboarding@resend.dev ne peut écrire
#   qu'au propriétaire du compte Resend. Pour envoyer à tous les utilisateurs,
#   vérifier un domaine (enregistrements DNS) et adapter EMAIL_FROM.
RESEND_API_KEY=""
# Brevo : https://brevo.com > SMTP & API > API Keys (300 emails/jour gratuits).
#   Il suffit de vérifier une adresse expéditrice (pas besoin de domaine).
# BREVO_API_KEY=""
# Expéditeur au format « Nom <adresse@domaine> ».
EMAIL_FROM="2iE Market <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Notifications Push Web (PWA)
# ---------------------------------------------------------------------------
# Générer la paire : npx web-push generate-vapid-keys
# La clé publique est exposée au navigateur (préfixe NEXT_PUBLIC_) ; la clé
# privée reste exclusivement côté serveur (Vercel > Environment Variables).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact RFC 8292 exigé par les services de push : « mailto:... » ou URL.
VAPID_SUBJECT="mailto:contact@2iemarket.bf"

# ---------------------------------------------------------------------------
# Recherche intelligente (facultatif)
# ---------------------------------------------------------------------------
# Sans clé, la recherche IA utilise le dictionnaire local (gratuit).
# Ne jamais préfixer cette variable par NEXT_PUBLIC_ : elle resterait serveur.
GEMINI_API_KEY=""
