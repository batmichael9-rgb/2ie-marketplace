{
  "name": "2ie-market",
  "version": "0.1.0",
  "private": true,
  "description": "Marketplace interne des étudiants de l'Institut 2iE (PWA Next.js)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:categories": "tsx prisma/seed.ts --categories-only",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/web-push": "^3.6.4",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "jose": "^6.2.17",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "web-push": "^4.0.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  }
}
