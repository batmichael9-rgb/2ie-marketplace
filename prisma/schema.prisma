// Schéma de la marketplace 2iE.
//
// Base de données : PostgreSQL (hébergé sur Supabase en production).
//   1. Renseigner DATABASE_URL dans .env (voir .env.example)
//   2. npx prisma db push        (crée les tables)
//   3. npm run db:seed           (données de démonstration)
// Pour revenir ponctuellement à SQLite en local : remplacer le provider par
// "sqlite" et DATABASE_URL par "file:./dev.db".
//
// Les champs de statut sont des String plutôt que des enums natifs afin de rester
// portables entre les deux moteurs. Les valeurs autorisées sont définies et
// validées dans src/lib/domain.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identité
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  password  String?  // Hash bcrypt ; nullable pour conserver les comptes créés avant l'authentification
  fullName  String
  role      String   @default("CLIENT") // CLIENT | VENDOR | ADMIN
  campusRoom String?
  // Numéro Mobile Money du client (et du vendeur) pour les paiements futurs.
  mobileMoneyNumber   String?
  mobileMoneyProvider String? // ORANGE_MONEY | MOOV_MONEY | WAVE
  createdAt DateTime @default(now())

  vendor  VendorProfile?
  orders  Order[]         @relation("BuyerOrders")
  reviews Review[]

  pushSubscriptions PushSubscription[]

  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  messages            Message[]
  preferenceSignals   UserPreferenceSignal[]
}

/// Code à usage unique (OTP) envoyé par email pour l'inscription ou la
/// réinitialisation du mot de passe. Seul le hash bcrypt est stocké.
model OtpCode {
  id         String    @id @default(cuid())
  email      String
  purpose    String // SIGNUP | RESET
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email, purpose, createdAt])
}

model VendorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  shopName    String
  slug        String   @unique
  description String?
  logoUrl     String?
  roomNumber  String? // champ facultatif du cahier des charges
  campus      String? // Site de Ouagadougou | Site de Kamboinsé
  momoNumber  String? // ancien champ, conservé pour compatibilité (miroir du compte préféré)
  momoOperator String? // ORANGE_MONEY | MOOV_MONEY | WAVE
  // Comptes de réception des reversements (part vendeur nette de commission).
  // Le numéro Orange Money est obligatoire pour activer la boutique et
  // publier des articles ; les autres moyens sont facultatifs.
  orangeMoneyNumber      String   @default("") // format +226XXXXXXXX
  moovMoneyNumber        String? // format +226XXXXXXXX
  waveNumber             String? // format +226XXXXXXXX
  bankCardOrAccount      String? // numéro de carte ou RIB pour virement
  preferredPayoutMethod  String   @default("ORANGE_MONEY") // ORANGE_MONEY | MOOV_MONEY | WAVE | CARD
  // Autorise (ou non) le paiement à la remise sur le campus en plus du
  // paiement en ligne. Activé par défaut pour ne pas bloquer les vendeurs
  // existants ; le vendeur peut le désactiver depuis son espace.
  acceptsCashPayment Boolean @default(true)
  isActive    Boolean  @default(true)
  isVerified  Boolean  @default(false)
  ratingAvg   Float    @default(0)
  ratingCount Int      @default(0)
  createdAt   DateTime @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  products   Product[]
  orders     Order[]
  shareLinks ShareLink[]
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  icon     String?
  position Int     @default(0)

  products Product[]
  preferenceSignals UserPreferenceSignal[]
}

model Product {
  id                String   @id @default(cuid())
  vendorId          String
  categoryId        String?
  name              String
  slug              String   @unique
  description       String
  priceXof          Int
  stockMode         String   @default("TRACKED") // TRACKED | UNLIMITED | OUT_OF_STOCK
  stockQty          Int      @default(0)
  lowStockThreshold Int      @default(3)
  isActive          Boolean  @default(true)
  isReservable      Boolean  @default(false)
  pickupNote        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendor         VendorProfile   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id])
  images         ProductImage[]
  orderItems     OrderItem[]
  reviews        Review[]
  shareLinks     ShareLink[]
  stockMovements StockMovement[]
  conversations  Conversation[]
  preferenceSignals UserPreferenceSignal[]

  @@index([vendorId, isActive])
  @@index([categoryId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  delta     Int
  reason    String // SALE | RESTOCK | MANUAL_ADJUST | CANCEL
  orderId   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model ShareLink {
  id               String   @id @default(cuid())
  code             String   @unique
  productId        String
  vendorId         String
  channel          String   @default("whatsapp")
  opensCount       Int      @default(0)
  conversionsCount Int      @default(0)
  createdAt        DateTime @default(now())

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor  VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orders  Order[]
}

// ---------------------------------------------------------------------------
// Commandes et réservations
// ---------------------------------------------------------------------------

model Order {
  id            String   @id @default(cuid())
  reference     String   @unique // "2IE-8F3K2A"
  buyerId       String
  vendorId      String
  shareLinkId   String?
  type          String   @default("DIRECT") // DIRECT | RESERVATION
  status        String   @default("AWAITING_PAYMENT")
  paymentStatus String   @default("UNPAID")
  subtotalXof   Int
  feesXof       Int      @default(0)
  totalXof      Int
  // Montants du paiement en ligne : le prix payé par l'acheteur est exactement
  // le prix du catalogue (grossAmount). La commission plateforme (taux
  // PLATFORM_FEE_PERCENT) est retenue sur ce montant, le solde revient au vendeur.
  grossAmount    Int    @default(0)
  platformFee    Int    @default(0)
  vendorNetAmount Int   @default(0)
  // PENDING | READY_FOR_PAYOUT | PROCESSING | PAID | FAILED (paiements en ligne uniquement).
  payoutStatus  String   @default("PENDING")
  // Dernier message d'erreur du virement Money Fusion (diagnostic admin/vendeur).
  payoutError   String?
  // Suivi Money Fusion : token renvoyé à l'initialisation du Payin, puis
  // tokenPay du Payout vendeur. Aucune de ces valeurs n'est exposée au client.
  paymentToken  String? // token Payin (alias historique tokenPay)
  tokenPay      String? // token Payin utilisé pour l'idempotence des webhooks
  payoutToken   String? // token du virement vendeur (Payout)
  currency      String   @default("XOF")
  buyerName     String
  buyerPhone    String
  buyerRoom     String?
  buyerNote     String?
  pickupSlot    String?
  expiresAt     DateTime?
  confirmedAt   DateTime?
  completedAt   DateTime?
  // Horodatage du passage en « Livrée » : l'auto-release de la part nette se déclenche
  // 48 h plus tard si l'acheteur n'a pas confirmé la réception.
  deliveredAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  buyer     User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  vendor    VendorProfile @relation(fields: [vendorId], references: [id])
  shareLink ShareLink?    @relation(fields: [shareLinkId], references: [id])
  items     OrderItem[]
  payments  Payment[]

  @@index([vendorId, status, createdAt])
  @@index([buyerId, createdAt])
  @@index([tokenPay])
  @@index([payoutToken])
  @@index([payoutStatus, deliveredAt])
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  productId       String
  quantity        Int
  unitPriceXof    Int
  productSnapshot String // JSON sérialisé : nom, image, prix au moment de l'achat

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  review  Review?

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Paiement
// ---------------------------------------------------------------------------

model Payment {
  id             String    @id @default(cuid())
  orderId        String
  provider       String // CASH | MONEYFUSION
  operator       String? // ORANGE_MONEY | MOOV_MONEY
  idempotencyKey String // clé générée côté client, réutilisée en cas de retry
  merchantRef    String    @unique // référence envoyée au PSP
  amountXof      Int
  currency       String    @default("XOF")
  status         String    @default("CREATED") // CREATED | PENDING | SUCCEEDED | FAILED | EXPIRED | REFUNDED
  providerTxnId  String?   @unique
  checkoutUrl    String?
  notifyToken    String? // token Payin (Money Fusion)
  attemptNo      Int       @default(1)
  lastError      String?
  rawInitPayload  String?
  rawFinalPayload String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  confirmedAt    DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, idempotencyKey])
  @@index([status, createdAt])
}

model PaymentEvent {
  id             String    @id @default(cuid())
  paymentId      String?
  provider       String
  providerEventId String
  eventType      String?
  payload        String
  signatureValid Boolean
  processedAt    DateTime?
  processingError String?
  receivedAt     DateTime  @default(now())

  @@unique([provider, providerEventId])
}

// ---------------------------------------------------------------------------
// Avis
// ---------------------------------------------------------------------------

model Review {
  id          String   @id @default(cuid())
  productId   String
  orderItemId String?  @unique // renseigné pour un achat vérifié, null pour un avis libre
  buyerId     String
  rating      Int
  comment     String?
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  buyer     User      @relation(fields: [buyerId], references: [id])

  @@unique([buyerId, productId])
  @@index([productId, createdAt])
}

// ---------------------------------------------------------------------------
// Messagerie interne acheteur ↔ vendeur
// ---------------------------------------------------------------------------

/// Fil de discussion entre un client et un vendeur, éventuellement rattaché à
/// un produit précis (bouton « Discuter avec le vendeur »).
model Conversation {
  id        String   @id @default(cuid())
  productId String?
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  buyer    User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([buyerId, sellerId, productId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Préférences & personnalisation
// ---------------------------------------------------------------------------

/// Signal d'intérêt très léger (une ligne par consultation/recherche/commande).
/// Aucun contenu sensible : il sert uniquement à calculer les recommandations
/// (catégories consultées, campus, fraîcheur) et reste supprimable sans impact.
model UserPreferenceSignal {
  id         String   @id @default(cuid())
  userId     String
  categoryId String?
  productId  String?
  actionType String // VIEW_PRODUCT | SEARCH | ORDER | REVIEW
  query      String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Notifications Push Web (PWA)
// ---------------------------------------------------------------------------

/// Abonnement d'un appareil aux notifications du navigateur. Un utilisateur
/// peut en avoir plusieurs (téléphone + ordinateur).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
