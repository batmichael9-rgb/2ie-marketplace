// Schéma PostgreSQL de la marketplace 2iE.
generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

model User {
  id String @id @default(cuid())
  email String? @unique
  phone String? @unique
  password String? // Hash bcrypt pour les nouveaux comptes; nullable pour migrer les anciens comptes sans interruption DB
  fullName String
  role String @default("CLIENT")
  campusRoom String?
  createdAt DateTime @default(now())
  vendor VendorProfile?
  orders Order[] @relation("BuyerOrders")
  reviews Review[]
}
model VendorProfile {
  id String @id @default(cuid())
  userId String @unique
  shopName String
  slug String @unique
  description String?
  logoUrl String?
  roomNumber String?
  momoNumber String?
  momoOperator String?
  isActive Boolean @default(true)
  isVerified Boolean @default(false)
  ratingAvg Float @default(0)
  ratingCount Int @default(0)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  orders Order[]
  shareLinks ShareLink[]
}
model Category { id String @id @default(cuid()); name String; slug String @unique; icon String?; position Int @default(0); products Product[] }
model Product {
  id String @id @default(cuid())
  vendorId String
  categoryId String?
  name String
  slug String @unique
  description String
  priceXof Int
  stockMode String @default("TRACKED")
  stockQty Int @default(0)
  lowStockThreshold Int @default(3)
  isActive Boolean @default(true)
  isReservable Boolean @default(false)
  pickupNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])
  images ProductImage[]
  orderItems OrderItem[]
  reviews Review[]
  shareLinks ShareLink[]
  stockMovements StockMovement[]
  @@index([vendorId, isActive])
  @@index([categoryId])
}
model ProductImage { id String @id @default(cuid()); productId String; url String; position Int @default(0); product Product @relation(fields: [productId], references: [id], onDelete: Cascade); @@index([productId]) }
model StockMovement { id String @id @default(cuid()); productId String; delta Int; reason String; orderId String?; createdAt DateTime @default(now()); product Product @relation(fields: [productId], references: [id], onDelete: Cascade); @@index([productId, createdAt]) }
model ShareLink { id String @id @default(cuid()); code String @unique; productId String; vendorId String; channel String @default("whatsapp"); opensCount Int @default(0); conversionsCount Int @default(0); createdAt DateTime @default(now()); product Product @relation(fields: [productId], references: [id], onDelete: Cascade); vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade); orders Order[] }
model Order {
  id String @id @default(cuid()); reference String @unique; buyerId String; vendorId String; shareLinkId String?; type String @default("DIRECT"); status String @default("AWAITING_PAYMENT"); paymentStatus String @default("UNPAID"); subtotalXof Int; feesXof Int @default(0); totalXof Int; currency String @default("XOF"); buyerName String; buyerPhone String; buyerRoom String?; buyerNote String?; pickupSlot String?; expiresAt DateTime?; confirmedAt DateTime?; completedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt
  buyer User @relation("BuyerOrders", fields: [buyerId], references: [id]); vendor VendorProfile @relation(fields: [vendorId], references: [id]); shareLink ShareLink? @relation(fields: [shareLinkId], references: [id]); items OrderItem[]; payments Payment[]
  @@index([vendorId, status, createdAt]); @@index([buyerId, createdAt])
}
model OrderItem { id String @id @default(cuid()); orderId String; productId String; quantity Int; unitPriceXof Int; productSnapshot String; order Order @relation(fields: [orderId], references: [id], onDelete: Cascade); product Product @relation(fields: [productId], references: [id]); review Review?; @@index([orderId]) }
model Payment { id String @id @default(cuid()); orderId String; provider String; operator String?; idempotencyKey String; merchantRef String @unique; amountXof Int; currency String @default("XOF"); status String @default("CREATED"); providerTxnId String? @unique; checkoutUrl String?; notifyToken String?; attemptNo Int @default(1); lastError String?; rawInitPayload String?; rawFinalPayload String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; confirmedAt DateTime?; order Order @relation(fields: [orderId], references: [id], onDelete: Cascade); @@unique([provider, idempotencyKey]); @@index([status, createdAt]) }
model PaymentEvent { id String @id @default(cuid()); paymentId String?; provider String; providerEventId String; eventType String?; payload String; signatureValid Boolean; processedAt DateTime?; processingError String?; receivedAt DateTime @default(now()); @@unique([provider, providerEventId]) }
model Review { id String @id @default(cuid()); productId String; orderItemId String @unique; buyerId String; rating Int; comment String?; isVisible Boolean @default(true); createdAt DateTime @default(now()); product Product @relation(fields: [productId], references: [id], onDelete: Cascade); orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade); buyer User @relation(fields: [buyerId], references: [id]); @@unique([buyerId, productId]); @@index([productId, createdAt]) }
